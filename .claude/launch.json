{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "amazonas-http",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:http"
      ],
      "port": 5174
    },
    {
      "name": "amazonas-dist",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4180",
        "--directory",
        "dist"
      ],
      "port": 4180
    }
  ]
}